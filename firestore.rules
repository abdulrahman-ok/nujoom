rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.uid == 'ADMIN_UID'; }
    function isDevice() { return signedIn() && exists(/databases/$(database)/documents/devices/$(request.auth.uid)); }
    function validKid() {
      return request.resource.data.keys().hasOnly(['name', 'avatar', 'color', 'stars', 'best', 'pin'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.avatar is string && request.resource.data.avatar.size() <= 16
        && request.resource.data.color is string && request.resource.data.color.size() <= 9
        && request.resource.data.stars is int && request.resource.data.stars >= 0
        && request.resource.data.best is map
        && (!('pin' in request.resource.data)
            || (request.resource.data.pin is string && request.resource.data.pin.size() == 64));
    }

    // The girls: the admin and approved devices can see them all.
    // Devices can play and set passwords, but only the admin adds, renames or deletes a girl.
    match /kids/{kidId} {
      allow read: if isAdmin() || isDevice();
      allow create: if isAdmin() && validKid();
      allow update: if validKid() && (isAdmin() || (isDevice() && request.resource.data.name == resource.data.name));
      allow delete: if isAdmin();
    }

    // Approved devices: only the admin approves or removes them.
    match /devices/{deviceId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == deviceId);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow delete: if isAdmin();
    }

    // Requests: a new device can only write its own request.
    match /requests/{deviceId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == deviceId);
      allow create: if signedIn() && request.auth.uid == deviceId
        && request.resource.data.keys().hasOnly(['name', 'code', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.code is string && request.resource.data.code.size() == 4
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == deviceId);
    }

    // Older setup, kept only so the admin's earlier data can be moved over.
    match /users/{userId}/kids/{kidId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
